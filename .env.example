# Environment Variables for SHEMA STORE
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shema_store

# Session Configuration
SESSION_SECRET=change_this_to_a_secure_random_string

# JWT Configuration
JWT_SECRET=change_this_to_a_secure_random_string

# CORS Configuration
# Optional. Leave empty when frontend and backend share the same origin.
# For separate local clients, use a comma-separated allowlist.
CORS_ORIGIN=

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=server/uploads

# Optional WhatsApp business number (international format, without +)
WHATSAPP_BUSINESS_NUMBER=
